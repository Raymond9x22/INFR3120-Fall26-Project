<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>FoundIt - Campus Lost and Found Board</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!-- the top navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        <img src="/images/logo.png" alt="FoundIt logo" height="32" class="me-2">
        FoundIt
      </a>
      <a href="/report" class="btn btn-outline-light btn-sm">Report an Item</a>
    </div>
  </nav>

  <!-- the Hero/Action button section -->
  <div class="bg-primary text-white text-center py-5">
    <div class="container">
      <img src="/images/logo.png" alt="FoundIt logo" height="100" class="mb-3">
      <h1 class="display-4 fw-bold">FoundIt</h1>
      <p class="lead">Campus Lost and Found Board</p>
      <p>Lost something? Found something? Post it here in seconds.</p>
      <a href="/report" class="btn btn-light btn-lg mt-2">
        <i class="fa fa-plus-circle"></i> Report an Item
      </a>
    </div>
  </div>

  <!-- Table for the reported items -->
  <div class="container my-5">
    <h2 class="mb-4">Recent Reports</h2>

    <% if (items.length > 0) { %>
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>Item</th>
            <th>Description</th>
            <th>Status</th>
            <th>Location</th>
            <th>Date</th>
            <th>Contact</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < items.length; i++) { %>
            <tr>
              <td><%= items[i].itemName %></td>
              <td><%= items[i].description %></td>
              <td><%= items[i].status %></td>
              <td><%= items[i].location %></td>
              <td><%= items[i].date.toDateString() %></td>
              <td><%= items[i].contact %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } else { %>
      <div class="alert alert-info">
        No items have been reported yet.
        <a href="/report">Be the first to report one.</a>
      </div>
    <% } %>
  </div>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-3">
    <p class="mb-0">FoundIt 2026 - INFR3120 Group 10</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>